      padding-bottom: 6px;
      margin-bottom: 12px;
    }

    h1 {
      margin: 0;
      color: var(--text-bold);
      font-size: 1.25rem;
    }

    .header-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .theme-toggle, .btn {
