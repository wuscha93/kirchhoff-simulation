      --node-color: var(--curr-color);
      --eq-bg: #001e26;
      --eq-text: #93a1a1;
      --eq-highlight: #b58900;
      --eq-result: var(--primary);
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 12px;
      background-color: var(--bg);
      color: var(--text);
